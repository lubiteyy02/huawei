@startuml fig3-1
title 图 3-1 系统总体分层架构图

skinparam backgroundColor #FFFFFF
skinparam defaultFontName SimSun
skinparam defaultFontSize 11
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #333333
    BorderThickness 1
    RoundCorner 0
}

' ============ 第 1 层 用户层 ============
rectangle "**用户层**" as L1 #FAFAFA {
  rectangle "驾驶员" as U1
  rectangle "手机端用户" as U2
  rectangle "车机端用户" as U3
}

' ============ 第 2 层 应用层 ============
rectangle "**应用层**（叠加全局非阻断式快捷交互层）" as L2 #FAFAFA {
  rectangle "导航\n模块" as M1
  rectangle "多媒体\n模块" as M2
  rectangle "车辆监控\n模块" as M3
  rectangle "协同总览\n模块" as M4
  rectangle "登录与\n个人中心" as M5
  rectangle "全局快捷条（常驻）" as M6 #F0F0F0
}

' ============ 第 3 层 业务服务层 ============
rectangle "**业务服务层**（应用进程内单例服务）" as L3 #FAFAFA {
  rectangle "全局公告\n服务\n（事件总线）" as S1
  rectangle "协同视图\n模型" as S2
  rectangle "音频播放\n服务" as S3
  rectangle "歌词同步\n桥接服务" as S4
  rectangle "全局响应式\n状态存储" as S5
  rectangle "页面路由" as S6
}

' ============ 第 4 层 同步通信层 ============
rectangle "**同步通信层**" as L4 #FAFAFA {
  rectangle "协同接口\n服务\n（REST客户端）" as C1
  rectangle "协同同步\n套接字服务\n（WebSocket客户端）" as C2
  rectangle "高德地图\n桥接服务" as C3
  rectangle "令牌鉴权\n客户端" as C4
}

' ============ 第 5 层 后端服务层 ============
rectangle "**后端服务层**（Node.js + Express）" as L5 #FAFAFA {
  rectangle "账号控制器" as B1
  rectangle "协同控制器" as B2
  rectangle "媒体控制器" as B3
  rectangle "导航控制器" as B4
  rectangle "协同同步\n广播中心\n（WebSocket服务端）" as B5 #F0F0F0
}

' ============ 第 6 层 数据持久化层 ============
rectangle "**数据持久化层**（MySQL 8.x）" as L6 #FAFAFA {
  rectangle "用户/收藏/\n导航历史等\n主业务表" as D1
  rectangle "协同业务表\n（8张专属表）" as D2
}

' ============ 层间依赖（自上向下单向） ============
L1 -down-> L2
L2 -down-> L3
L3 -down-> L4
L4 -down-> L5
L5 -down-> L6

@enduml
