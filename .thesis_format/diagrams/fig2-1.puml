@startuml fig2-1
title 图 2-1  系统总体用例图

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF

left to right direction

actor "驾驶员" as A1
actor "手机端用户" as A2
actor "后端系统" as A3

rectangle "车载信息娱乐系统" {

  package "账号身份" as P1 {
    usecase "用户注册" as UC01
    usecase "用户登录" as UC02
    usecase "退出登录" as UC03
  }

  package "导航业务" as P2 {
    usecase "路径规划" as UC04
    usecase "POI检索" as UC05
    usecase "收藏地点" as UC06
    usecase "导航历史" as UC07
  }

  package "多媒体业务" as P3 {
    usecase "音频播放" as UC08
    usecase "歌词同步" as UC09
    usecase "播放控制" as UC10
  }

  package "全局交互" as P4 {
    usecase "全局快捷控制" as UC11
  }

  package "车辆监控" as P5 {
    usecase "实时仪表盘" as UC12
    usecase "行驶记录" as UC13
  }

  package "多设备协同" as P6 {
    usecase "设备发现" as UC14
    usecase "协同联系人" as UC15
    usecase "协同短信" as UC16
    usecase "音乐跨端续接" as UC17
    usecase "导航跨端续接" as UC18
  }

}

A1 -- P1
A1 -- P2
A1 -- P3
A1 -- P4
A1 -- P5
A1 -- P6

A2 -- P6

P1 -- A3
P2 -- A3
P6 -- A3

@enduml
